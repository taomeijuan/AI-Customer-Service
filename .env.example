# 复制为 .env 并填入真实值：cp .env.example .env
# 应用侧统一 OpenAI 协议，换上游只改下面三项

# ── DeepSeek ─────────────────────────────────────────────
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxx
LLM_MODEL=deepseek-chat

# ── OpenAI GPT（官方，删除 BASE_URL 行即可）──────────────
# LLM_API_KEY=sk-xxxx
# LLM_MODEL=gpt-4o-mini

# ── Claude（Anthropic OpenAI 兼容端点）──────────────────
# LLM_BASE_URL=https://api.anthropic.com/v1/
# LLM_API_KEY=sk-ant-xxxx
# LLM_MODEL=claude-sonnet-4-5-20250929

# ── Ollama 本地（无需密钥，KEY 随便填占位符）─────────────
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:7b

# ── 以下保持默认即可 ─────────────────────────────────────
LLM_TEMPERATURE=0.7
TOKEN_BUDGET=4000

# ── MySQL（ch02 起，docker-compose 起）───────────────────
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ecom
MYSQL_PASSWORD=ecom123
MYSQL_DATABASE=ecom_cs
TOOL_TIMEOUT=3.0
TOOL_RETRIES=1
